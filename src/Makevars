# The bundled llama.cpp and GGML sources target C++17, which is what upstream
# builds and tests. Without this pin each platform applies its own default:
# R 4.6 on macOS compiles with -std=gnu++20, and the libc++ in MacOSX11.sdk
# changes the return type of std::filesystem::path::u8string() between the two
# standards, which broke the r-release-macos-x86_64 install in 0.4.1. Fixing
# the dialect keeps every platform on the standard the vendored code expects.
CXX_STD = CXX17

PKG_CPPFLAGS = -I../inst/include -I./llama -I./llama/models -I./ggml -I./ggml/ggml-cpu -DUSING_R=1 -DGGML_BUILD_FOR_R
PKG_CXXFLAGS = -DNDEBUG -DGGML_USE_CPU
PKG_CFLAGS = -DNDEBUG -DGGML_USE_CPU

# Extra flags for the vendored engine. These are APPENDED to R's
# $(ALL_CFLAGS)/$(ALL_CXXFLAGS) in every rule below, never used in place of
# them, so that CFLAGS and CXXFLAGS set by the user or the site Makevars
# reach the sources in ggml/ and llama/ as well as the top-level ones.
# Optimisation, PIC and -DNDEBUG all arrive through $(ALL_*FLAGS); only
# genuinely engine-specific additions belong here.
GGML_EXTRA_CXXFLAGS = -ftree-vectorize
# -fexceptions: the ggml abort callback in bindings.cpp throws a C++
# exception that must unwind through ggml_abort() and other C frames.
GGML_EXTRA_CFLAGS = -ftree-vectorize -fno-builtin-printf -fexceptions
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# Apple Accelerate framework for macOS (vDSP vector operations)
UNAME_S := $(shell uname -s 2>/dev/null)
ifeq ($(UNAME_S),Darwin)
  GGML_EXTRA_CXXFLAGS += -DGGML_USE_ACCELERATE
  GGML_EXTRA_CFLAGS += -DGGML_USE_ACCELERATE
  PKG_LIBS += -framework Accelerate
endif

# Model-specific objects (one file per model architecture)
MODEL_OBJECTS = $(patsubst llama/models/%.cpp,llama/models/%.o,$(wildcard llama/models/*.cpp))

# Core object files (common to all architectures)
CORE_OBJECTS = bindings.o RcppExports.o \
	ggml/ggml.o ggml/ggml-alloc.o ggml/gguf.o \
	ggml/ggml-backend.o ggml/ggml-backend-reg.o ggml/ggml-backend-dl.o ggml/ggml-backend-meta.o \
	ggml/ggml-quants.o ggml/ggml-threading.o ggml/ggml-opt.o \
	llama/llama-adapter.o llama/llama-arch.o llama/llama-batch.o llama/llama-chat.o \
	llama/llama-context.o llama/llama-cparams.o llama/llama-grammar.o llama/llama-graph.o \
	llama/llama-hparams.o llama/llama-impl.o llama/llama-io.o llama/llama-kv-cache-iswa.o \
	llama/llama-kv-cache-dsa.o llama/llama-kv-cache-dsa-iswa.o llama/llama-kv-cache-dsv4.o \
	llama/llama-kv-cache-msa.o llama/llama-memory-hybrid-idx.o llama/llama-moe-cache.o \
	llama/llama-kv-cache.o llama/llama-memory-hybrid.o llama/llama-memory-hybrid-iswa.o \
	llama/llama-memory-recurrent.o \
	llama/llama-memory.o llama/llama-mmap.o llama/llama-model-loader.o llama/llama-model-saver.o llama/llama-model.o \
	llama/llama-quant.o llama/llama-sampler.o llama/llama-vocab.o llama/llama.o \
	llama/unicode-data.o llama/unicode.o \
	ggml/ggml-cpu/ggml-cpu-c.o ggml/ggml-cpu/ggml-cpu-cpp.o ggml/ggml-cpu/ops.o \
	ggml/ggml-cpu/binary-ops.o ggml/ggml-cpu/unary-ops.o ggml/ggml-cpu/vec.o \
	ggml/ggml-cpu/traits.o ggml/ggml-cpu/repack.o ggml/ggml-cpu/quants.o \
	ggml/ggml-cpu/tiled/tiled.o ggml/ggml-cpu/tiled/tiled-kernel.o \
	simd_info.o

# ============================================================================
# SIMD Optimization Configuration
# ============================================================================
# Architecture detection and SIMD flag selection.
#
# Override at install time by setting the EDGEMODELR_SIMD environment variable:
#   EDGEMODELR_SIMD=AVX2 R CMD INSTALL edgemodelr
#
# Valid values: GENERIC, SSE42, AVX, AVX2, AVX512, NATIVE
# Default (no env var): NEON kernels on 64-bit ARM, which need no extra
# flags, and the portable generic build (GGML_CPU_GENERIC, no arch flags)
# everywhere else -- see the last two branches below.
# ============================================================================

UNAME_M := $(shell uname -m 2>/dev/null)
ARM_OBJECTS = ggml/ggml-cpu/arch/arm/quants.o ggml/ggml-cpu/arch/arm/repack.o ggml/ggml-cpu/arch/arm/cpu-feats.o

ifeq ($(EDGEMODELR_SIMD),GENERIC)
  GGML_EXTRA_CXXFLAGS += -DGGML_CPU_GENERIC
  GGML_EXTRA_CFLAGS += -DGGML_CPU_GENERIC
  ARCH_OBJECTS =
else ifeq ($(EDGEMODELR_SIMD),NATIVE)
  GGML_EXTRA_CXXFLAGS += -march=native
  GGML_EXTRA_CFLAGS += -march=native
  ifeq ($(UNAME_M),x86_64)
    ARCH_OBJECTS = ggml/ggml-cpu/arch/x86/quants.o ggml/ggml-cpu/arch/x86/repack.o ggml/ggml-cpu/arch/x86/cpu-feats.o
  else ifneq ($(filter aarch64 arm64,$(UNAME_M)),)
    ARCH_OBJECTS = $(ARM_OBJECTS)
  else
    ARCH_OBJECTS =
  endif
else ifeq ($(EDGEMODELR_SIMD),AVX512)
  GGML_EXTRA_CXXFLAGS += -mavx512f -mavx512bw -mavx512dq -mavx512vl -mavx2 -mfma -mf16c -DGGML_AVX512 -DGGML_AVX2 -DGGML_FMA -DGGML_F16C -DGGML_AVX -DGGML_SSE42
  GGML_EXTRA_CFLAGS += -mavx512f -mavx512bw -mavx512dq -mavx512vl -mavx2 -mfma -mf16c -DGGML_AVX512 -DGGML_AVX2 -DGGML_FMA -DGGML_F16C -DGGML_AVX -DGGML_SSE42
  ARCH_OBJECTS = ggml/ggml-cpu/arch/x86/quants.o ggml/ggml-cpu/arch/x86/repack.o ggml/ggml-cpu/arch/x86/cpu-feats.o
else ifeq ($(EDGEMODELR_SIMD),AVX2)
  GGML_EXTRA_CXXFLAGS += -mavx2 -mfma -mf16c -DGGML_AVX2 -DGGML_FMA -DGGML_F16C -DGGML_AVX -DGGML_SSE42
  GGML_EXTRA_CFLAGS += -mavx2 -mfma -mf16c -DGGML_AVX2 -DGGML_FMA -DGGML_F16C -DGGML_AVX -DGGML_SSE42
  ARCH_OBJECTS = ggml/ggml-cpu/arch/x86/quants.o ggml/ggml-cpu/arch/x86/repack.o ggml/ggml-cpu/arch/x86/cpu-feats.o
else ifeq ($(EDGEMODELR_SIMD),AVX)
  GGML_EXTRA_CXXFLAGS += -mavx -mf16c -DGGML_AVX -DGGML_F16C -DGGML_SSE42
  GGML_EXTRA_CFLAGS += -mavx -mf16c -DGGML_AVX -DGGML_F16C -DGGML_SSE42
  ARCH_OBJECTS = ggml/ggml-cpu/arch/x86/quants.o ggml/ggml-cpu/arch/x86/repack.o ggml/ggml-cpu/arch/x86/cpu-feats.o
else ifeq ($(EDGEMODELR_SIMD),SSE42)
  GGML_EXTRA_CXXFLAGS += -msse4.2 -DGGML_SSE42
  GGML_EXTRA_CFLAGS += -msse4.2 -DGGML_SSE42
  ARCH_OBJECTS = ggml/ggml-cpu/arch/x86/quants.o ggml/ggml-cpu/arch/x86/repack.o ggml/ggml-cpu/arch/x86/cpu-feats.o
else ifneq ($(filter aarch64 arm64,$(UNAME_M)),)
  # Default on 64-bit ARM (Apple silicon, ARM Linux): the NEON kernels.
  # NEON is part of the aarch64 baseline, so this needs no -m or -march
  # flags; the compiler's default target decides which extensions (dotprod
  # on Apple silicon) the kernels use. About 3x faster than generic C.
  ARCH_OBJECTS = $(ARM_OBJECTS)
else
  # Default elsewhere: portable generic build (no arch-specific flags).
  # CRAN policy prohibits non-portable compiler flags (-msse4.2, -mavx, etc.)
  # in the default install path. Users who want SIMD acceleration should set
  # EDGEMODELR_SIMD=SSE42 (or AVX2/AVX512/NATIVE) at install time.
  GGML_EXTRA_CXXFLAGS += -DGGML_CPU_GENERIC
  GGML_EXTRA_CFLAGS += -DGGML_CPU_GENERIC
  ARCH_OBJECTS =
  # On x86-64 the generic build also carries the AVX2 kernels, built with a
  # target pragma in edgemodelr-avx2.c rather than a compiler flag, and
  # switches to them at run time on CPUs that have AVX2.
  ifeq ($(UNAME_M),x86_64)
    DISPATCH_OBJECTS = ggml/ggml-cpu/edgemodelr-avx2.o
    GGML_EXTRA_CFLAGS += -DEDGEMODELR_CPU_DISPATCH
  endif
endif

# Complete objects list with architecture support and model implementations
OBJECTS = $(CORE_OBJECTS) $(MODEL_OBJECTS) $(ARCH_OBJECTS) $(DISPATCH_OBJECTS)

all: $(SHLIB)

clean:
	rm -f $(OBJECTS) $(SHLIB)

# Special rules for conflicting ggml-cpu files
ggml/ggml-cpu/ggml-cpu-c.o: ggml/ggml-cpu/ggml-cpu.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(GGML_EXTRA_CFLAGS) -c $< -o $@

ggml/ggml-cpu/ggml-cpu-cpp.o: ggml/ggml-cpu/ggml-cpu.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

# Standard compilation rules for main source files
bindings.o: bindings.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fPIC -c $< -o $@

RcppExports.o: RcppExports.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fPIC -c $< -o $@

# ggml-cpu generic implementations: compiled without SIMD flags to provide
# *_generic fallback functions referenced by arch-specific SIMD compilation units.
#
# CRITICAL: whether -DGGML_CPU_GENERIC is passed depends on the build mode:
#   - GENERIC build (ARCH_OBJECTS empty): include -DGGML_CPU_GENERIC so that
#     arch-fallback.h maps _generic calls to plain names, matching what
#     ggml-cpu.cpp (also compiled with GGML_CPU_GENERIC) calls.
#   - SIMD build (ARCH_OBJECTS non-empty): do NOT include -DGGML_CPU_GENERIC so
#     that arch-fallback.h macros are NOT active and functions like
#     ggml_gemv_q4_0_8x8_q8_0_generic are emitted with their true _generic names,
#     which arch/x86/repack.o and arch/x86/quants.o reference as external symbols.
ifeq ($(ARCH_OBJECTS),)
GENERIC_EXTRA_CFLAGS   = -ftree-vectorize -fexceptions -DGGML_CPU_GENERIC
GENERIC_EXTRA_CXXFLAGS = -ftree-vectorize -DGGML_CPU_GENERIC
else
GENERIC_EXTRA_CFLAGS   = -ftree-vectorize -fexceptions
GENERIC_EXTRA_CXXFLAGS = -ftree-vectorize
endif

# The AVX2 kernels of the generic build: compiled without GGML_CPU_GENERIC so
# that arch/x86/quants.c takes its AVX2 paths (see edgemodelr-avx2.c).
ggml/ggml-cpu/edgemodelr-avx2.o: ggml/ggml-cpu/edgemodelr-avx2.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(filter-out -DGGML_CPU_GENERIC,$(GGML_EXTRA_CFLAGS)) -c $< -o $@

ggml/ggml-cpu/quants.o: ggml/ggml-cpu/quants.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(GENERIC_EXTRA_CFLAGS) -c $< -o $@

ggml/ggml-cpu/repack.o: ggml/ggml-cpu/repack.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GENERIC_EXTRA_CXXFLAGS) -c $< -o $@

# Special rules for GGML/LLAMA files
ggml/%.o: ggml/%.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(GGML_EXTRA_CFLAGS) -c $< -o $@

ggml/%.o: ggml/%.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

llama/%.o: llama/%.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

# SIMD info reporting (compiled with GGML flags to detect SIMD features)
simd_info.o: simd_info.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

# Model-specific compilation rule
llama/models/%.o: llama/models/%.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

# Architecture-specific rules for x86
ggml/ggml-cpu/arch/x86/%.o: ggml/ggml-cpu/arch/x86/%.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(GGML_EXTRA_CFLAGS) -c $< -o $@

ggml/ggml-cpu/arch/x86/%.o: ggml/ggml-cpu/arch/x86/%.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

# Architecture-specific rules for ARM
ggml/ggml-cpu/arch/arm/%.o: ggml/ggml-cpu/arch/arm/%.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(GGML_EXTRA_CFLAGS) -c $< -o $@

ggml/ggml-cpu/arch/arm/%.o: ggml/ggml-cpu/arch/arm/%.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(GGML_EXTRA_CXXFLAGS) -c $< -o $@

# Standard fallback rules
%.o: %.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -fPIC -c $< -o $@

%.o: %.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fPIC -c $< -o $@
